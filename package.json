    "hoek": "^4.2.1",
    "axios": "^0.18.1",
    "minimist": "^0.2.1",
    "set-value": "^2.0.1",
    "js-yaml": "^3.13.1",
    "mixin-deep": "^1.3.2",
    "kind-of": "^6.0.3",
