{
  "name": "react-tabulator",
  "version": "0.21.0",
  "description": "React Tabulator is based on tabulator - a JS table library with many advanced features.",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "css",
    "es",
    "lib",
    "umd"
  ],
"scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "postbuild": "cp ./src/styles.css ./lib/ && cp -R ./src/css ./lib && cp ./src/styles.css ./ && cp -R ./src/css ./",
    "lint": "eslint .",
    "preview": "vite preview",
    "demo": "vite"
  },
  "repository": {
    "type": "git",
    "url": "git+https://ngduc@github.com/ngduc/react-tabulator.git"
  },
  "keywords": [
    "react",
    "tabulator",
    "table",
    "component"
  ],
  "author": "Duc Nguyen",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ngduc/react-tabulator/issues"
  },
  "homepage": "https://github.com/ngduc/react-tabulator#readme",
  "dependencies": {
    "@types/babel__traverse": "^7.28.0",
    "@types/react-tag-autocomplete": "^6.3.3",
    "@types/tabulator-tables": "6.3.1",
    "dotenv": "^16.3.1",
    "pick-react-known-prop": "^0.1.5",
    "react-tag-autocomplete": "^7.5.1",
    "tabulator-tables": "6.3.1"
  },
  "peerDependencies": {
    "react": ">=15.6.2 || ^16.0.0 || ^17.0.0",
    "react-dom": ">=15.6.2 || ^16.0.0 || ^17.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "@types/tabulator-tables": "^6.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "babel-jest": "^30.2.0",
    "concurrently": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "event-stream": "4.0.1",
    "globals": "^16.5.0",
    "jest": "^30.0.2",
    "jest-puppeteer": "^11.0.0",
    "puppeteer": "^23.11.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4"

